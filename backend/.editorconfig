root = true

[*]
indent_style = space
indent_size = 4
end_of_line = crlf
insert_final_newline = true
charset = utf-8

[*.{json,xml,csproj,props,slnx}]
indent_size = 2

[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_style_var_for_built_in_types = true:suggestion
dotnet_sort_system_directives_first = true

[tests/**.cs]
# Test names use Method_Scenario_Expected
dotnet_diagnostic.CA1707.severity = none

[src/WebApp.Infrastructure/Migrations/**.cs]
# EF Core generates these files; analyzers don't apply to generated code.
generated_code = true
