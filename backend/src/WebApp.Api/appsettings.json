{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Jwt": {
    "Issuer": "WebApp.Api",
    "Audience": "WebApp.Client",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 14
  },
  "RateLimiting": {
    "AuthPerMinute": 10
  }
}
